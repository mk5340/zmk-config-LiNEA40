#include "LiNEA40.dtsi"
#include <input/processors.dtsi>　// ←追加：加速度
#include <behaviors/input_gestures_accel.dtsi>　// ←追加：加速度

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH> //col0-D10
        , <&xiao_d 9 GPIO_ACTIVE_HIGH>  //col1-D9
        , <&xiao_d 8 GPIO_ACTIVE_HIGH>  //col2-D8
        , <&xiao_d 7 GPIO_ACTIVE_HIGH>  //col3-D7
        , <&gpio0 10 GPIO_ACTIVE_HIGH>  //col4-NFC2
        ;
};

/ {
    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;

    };
};


&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>   // SCLK-D5
                  , <NRF_PSEL(SPIM_MOSI, 0, 4)>  // SDIO-D4
                  , <NRF_PSEL(SPIM_MISO, 0, 4)>  // SDIO-D4
                  ;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>   // SCLK-D5
                  , <NRF_PSEL(SPIM_MOSI, 0, 4)>  // SDIO-D4
                  , <NRF_PSEL(SPIM_MISO, 0, 4)>  // SDIO-D4
                  ;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>; //NCS-NFC1

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&xiao_d 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; //MOT-D6
        //automouse-layer = <1>; 20261031 無効化
        snipe-layers = <2>;
        scroll-layers = <3>;
        //scroll-layers = <4 5 6>;
    };
};

&trackball_listener {
    status = "okay";
    device = <&trackball>;
};

&pointer_accel {
        input-type = <INPUT_EV_REL>; // 相対座標デバイス（トラックボールやマウス等）用[cite: 6, 7]
        track-remainders;           // 端数の移動量を蓄積して精度を上げる[cite: 7]
        min-factor = <800>;         // 低速時の倍率（800 = 0.8倍）[cite: 6, 7]
        max-factor = <3000>;        // 高速時の最大倍率（3000 = 3.0倍）[cite: 6, 7]
        speed-threshold = <1200>;   // 加速が開始する速度の閾値[cite: 6, 7]
        speed-max = <6000>;         // 最高速に達する速度の閾値[cite: 6, 7]
        acceleration-exponent = <2>; // 加速カーブ（1=リニア、2=二次関数、3=三乗）[cite: 6, 7]
};