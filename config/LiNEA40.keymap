#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <125>;
};

&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <120>;
    flavor = "balanced";
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <CURSOR>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転,,,,,,,,,,,,,,,,,,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        ZenkakuHankaku {
            bindings = <&kp GRAVE>;
            key-positions = <11 12>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <7 8>;
        };

        LeftClick {
            bindings = <&mkp MB1>;
            key-positions = <17 18>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    macros {
        Add: Add {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp SEMICOLON>,
                <&macro_release>,
                <&kp LEFT_SHIFT>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "ADD";
        };

        Delete: Delete {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp MINUS>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "DELETE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W        &kp E               &kp R  &kp T                                  &kp Y                      &kp U    &kp I                &kp O    &kp P
&mt LEFT_SHIFT A  &mt LCTRL S  &kp D               &kp F  &kp G                                  &kp H                      &lt 3 J  &kp K                &kp L    &mt RCTRL ENTER
&lt 5 Z           &kp X        &kp C               &kp V  &kp B                                  &kp N                      &kp M    &kp COMMA            &kp DOT  &kp MINUS
&kp ESC           &kp F7       &mt LEFT_ALT GRAVE  &mo 1  &lt 3 SPACE  &lt 2 TAB    &lt 3 GRAVE  &mt RIGHT_SHIFT BACKSPACE           &lt 6 RIGHT_BRACKET  &kp F10  &kp RGUI
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        //1

        KIGO {
            bindings = <
&kp LS(N5)    &kp LS(DOLLAR)  &kp LS(N6)            &kp UNDERSCORE     &kp SLASH                      &kp INT3      &kp LS(RIGHT_BRACKET)  &kp LS(NON_US_HASH)  &kp LESS_THAN  &kp GREATER_THAN
&kp LS(INT3)  &kp LS(N3)      &kp LS(SINGLE_QUOTE)  &kp LS(SEMICOLON)  &kp LS(MINUS)                  &kp LBKT      &kp LS(N8)             &kp LS(N9)           &kp SEMICOLON  &kp SINGLE_QUOTE
&kp EQUAL     &kp LS(EQUAL)   &none                 &kp LS(N1)         &kp LS(SLASH)                  &kp LS(LBKT)  &kp RBKT               &kp NON_US_HASH      &kp LS(N7)     &kp LS(N2)
&none         &none           &none                 &none              &none          &none    &none  &none                                &none                &none          &kp RGUI
            >;
        };

        //2

        NUMBER {
            bindings = <
&none  &none  &none  &none  &none                  &kp CARET  &kp NUMBER_7  &kp N8        &kp NUMBER_9  &kp COMMA
&none  &none  &none  &none  &none                  &kp COLON  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_0
&none  &none  &none  &none  &none                  &kp TILDE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD
&none  &none  &none  &none  &none  &none    &none  &none                    &none         &none         &none
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        //3

        CURSOR {
            bindings = <
&kp LC(W)                  &kp LG(LEFT_ARROW)      &kp LG(UP_ARROW)       &kp LG(RIGHT_ARROW)  &Add                         &kp PAGE_UP             &kp HOME        &kp UP_ARROW    &kp END          &kp PAGE_DOWN
&mt LEFT_SHIFT LEFT_SHIFT  &mt LEFT_CONTROL LCTRL  &mt LEFT_ALT LEFT_ALT  &kp TAB              &Delete                      &kp LA(LEFT_ARROW)      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LA(RIGHT_ARROW)
&kp LC(T)                  &kp LC(X)               &kp LC(C)              &kp LC(V)            &none                        &kp LC(PAGE_UP)         &kp F2          &kp F5          &kp F4           &kp LC(PAGE_DOWN)
&none                      &none                   &none                  &none                &none    &none    &kp LG(V)  &mt RIGHT_SHIFT DELETE                  &none           &none            &kp F2
            >;
        };

        //4

        FUNCTION {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5                     &trans      &trans  &kp LA(PRINTSCREEN)  &trans  &kp LC(LA(DELETE))
&kp F6  &kp F7  &kp F8  &kp F9   &kp F10                    &trans      &trans  &kp LS(LG(S))        &trans  &kp LC(LS(ESCAPE))
&trans  &trans  &trans  &kp F11  &kp F12                    &kp C_MUTE  &trans  &trans               &trans  &kp LC(LA(INS))
&trans  &trans  &trans  &trans   &trans   &trans    &trans  &trans              &trans               &trans  &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        //5

        Control {
            bindings = <
&none  &none  &none  &none  &none                  &none      &kp LG(NUMBER_7)  &kp LG(NUMBER_8)  &kp LG(NUMBER_9)  &kp LG(S)
&none  &none  &none  &none  &none                  &none      &kp LG(NUMBER_4)  &kp LG(NUMBER_5)  &kp LG(NUMBER_6)  &kp LC(NUMBER_1)
&none  &none  &none  &none  &none                  &kp LC(R)  &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &kp LC(NUMBER_2)
&none  &none  &none  &none  &none  &none    &none  &none                        &none             &none             &none
            >;

            sensor-bindings = <&inc_dec_kp DOWN_ARROW UP_ARROW>;
        };

        //6

        WIRELESS {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans    &bootloader  &studio_unlock                &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };
    };
};
